# Copy to .env (repository root) and adjust. Real environment variables override this file.
# All sizes are in MB, durations in seconds unless noted.

# --- Storage -----------------------------------------------------------------
# Where prepared media, per-job scratch space and the yt-dlp cache live.
# Default: <system temp dir>/yt-canvas
# YTC_DATA_DIR=/var/tmp/yt-canvas
# Total size of prepared media kept on disk; least-recently-used files are evicted.
YTC_CACHE_MAX_MB=4096
# Prepared media not accessed for this many hours is deleted.
YTC_CACHE_TTL_HOURS=6
# Refuse to start a preparation that would leave less free disk than this.
YTC_MIN_FREE_DISK_MB=1024
YTC_CLEANUP_INTERVAL_SECONDS=300

# --- Media preparation ---------------------------------------------------------
# Highest video height to prepare (H.264 at or below this is preferred).
YTC_MAX_HEIGHT=720
YTC_MAX_CONCURRENT_JOBS=2
YTC_MAX_QUEUED_JOBS=16
YTC_MAX_DOWNLOAD_MB=1024
YTC_MAX_DURATION_SECONDS=7200
YTC_RESOLVE_TIMEOUT=60
YTC_DOWNLOAD_TIMEOUT=1800
YTC_PROCESS_TIMEOUT=1800

# Only used when remuxing is impossible (e.g. VP9/AV1/Opus sources).
YTC_TRANSCODE_PRESET=veryfast
YTC_TRANSCODE_CRF=23
YTC_TRANSCODE_AUDIO_BITRATE=128k
# 0 lets FFmpeg decide.
YTC_FFMPEG_THREADS=2

# --- Streaming playback ----------------------------------------------------------
# Play YouTube's DASH tracks while they load: the backend forwards byte ranges from
# YouTube into the browser's Media Source Extensions and stores nothing on disk. The
# download-first pipeline above stays available. false turns POST /api/streams off (404).
YTC_ENABLE_STREAMING=true
# Highest video height offered for streaming (H.264 or AV1 tracks at or below it).
YTC_STREAM_MAX_HEIGHT=2160
# Largest byte range one track request may ask for, in MiB.
YTC_STREAM_MAX_RANGE_MB=16

# --- Discovery -------------------------------------------------------------------
YTC_PAGE_SIZE=20
YTC_MAX_SEARCH_RESULTS=100
YTC_MAX_LIST_RESULTS=500
YTC_METADATA_CACHE_TTL=600
YTC_DISCOVERY_TIMEOUT=45

# --- External tools ------------------------------------------------------------------
# yt-dlp needs a JavaScript runtime for YouTube. Deno (>= 2.3) is used automatically if it
# is on PATH. To use Node (>= 22) instead: YTC_YTDLP_JS_RUNTIMES=node
# (comma-separated, optional path: deno:/opt/deno/bin/deno)
# YTC_YTDLP_JS_RUNTIMES=
# Defaults to "<backend python> -m yt_dlp".
# YTC_YTDLP_COMMAND=
# YTC_FFMPEG_PATH=ffmpeg
# YTC_FFPROBE_PATH=ffprobe

# --- YouTube sign-in (opt-in) ----------------------------------------------------------
# Off by default. When set, yt-dlp uses your YouTube account's cookies for everything it
# fetches (so restricted and members-only videos you can watch can be prepared), the
# backend adds /api/me and /api/me/feed/* (Recommended, Subscriptions, History, Watch later,
# Liked videos) and related videos become personalized. While it's on, the API only answers
# requests from this computer. Set at most one of the two variables. See Signing in in the README.
#
# Read cookies straight from a browser profile, as yt-dlp's --cookies-from-browser does:
# BROWSER[+KEYRING][:PROFILE][::CONTAINER]. Browsers: brave, chrome, chromium, edge, firefox,
# opera, safari, vivaldi, whale. On macOS, Chromium browsers ask for Keychain access to
# "<Browser> Safe Storage" the first time (click Always Allow); Safari needs Full Disk Access
# for the app that runs the server.
# YTC_YTDLP_COOKIES_FROM_BROWSER=chrome
# YTC_YTDLP_COOKIES_FROM_BROWSER=chrome:Profile 1
#
# Or a Netscape-format cookies.txt (~ is expanded). yt-dlp rewrites this file with refreshed
# cookies after each run, so keep it somewhere private and don't share it.
# YTC_YTDLP_COOKIES_FILE=~/.config/yt-canvas/youtube-cookies.txt
#
# Also add videos you prepare to the account's YouTube watch history (needs sign-in).
# YTC_MARK_WATCHED=false

# --- Accounts (Clerk sign-in, data in Convex) -----------------------------------------------
# Set a Clerk publishable key to turn accounts on: everyone signs in, only people on the
# allowlist can, and each person's YouTube cookies, Plex, apps, library and devices follow
# their account. Without it yt-canvas runs in no-login mode. See Accounts in the README.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk's PEM public key, to verify session tokens without fetching Clerk's JWKS.
# CLERK_JWT_KEY=
# The Convex deployment's HTTP actions URL, and its deploy key (for scripts/deploy.py).
# CONVEX_SITE_URL=https://<deployment>.convex.site
# CONVEX_DEPLOY_KEY=
# Signing secret of the Clerk webhook pointed at <CONVEX_SITE_URL>/clerk-webhook.
# CLERK_WEBHOOK_SECRET=whsec_...
# Shared secret between this server and Convex's /backend action (also set in Convex's env).
# YTC_CONVEX_SECRET=
# AES-256-GCM key for secrets kept in Convex: 32 random bytes in urlsafe base64, e.g.
#   python3 -c 'import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# Losing it means everyone uploads their cookies and connects Plex again.
# YTC_SECRETS_KEY=
# Admins can manage the allowlist (Access page) and are always allowed. Comma-separated.
# YTC_ADMIN_EMAILS=you@example.com
# Origins whose session tokens are accepted. Default: the host the request was sent to.
# YTC_ALLOWED_ORIGINS=https://ytc.example.com
# off: no-login mode even when Clerk keys are set.
# YTC_ACCOUNTS=auto

# --- Add-on apps (Plex, ...) -----------------------------------------------------------------
# Which apps are on (turned on in the app's Apps page), kept outside the media cache.
# Default: ~/.config/yt-canvas
# YTC_CONFIG_DIR=~/.config/yt-canvas
# false keeps every app off and hides Apps, e.g. on a server shared through a tunnel.
YTC_ENABLE_APPS=true
# Plex sign-in endpoints (only change these for tests, e.g. the fake Plex in backend/tests/fakeplex.py).
# YTC_PLEX_TV_URL=https://plex.tv
# YTC_PLEX_AUTH_URL=https://app.plex.tv/auth

# --- App ---------------------------------------------------------------------------------
# Locally generated DEMO/TEST media (no network needed).
YTC_ENABLE_DEMO=true
# Cap demo generation at N× real time, like a download (0 = as fast as possible; FFmpeg 5.0+).
# The e2e suite uses 4 so preparation states stay observable on fast machines.
# YTC_DEMO_READRATE=0
# Home-page shelves (Music, News, Live, Gaming) and related videos, read from YouTube's
# public pages without cookies or sign-in. Set to false to keep the server off those pages.
YTC_ENABLE_FEEDS=true
# Production build served by the backend on the same origin. Default: frontend/dist
# YTC_FRONTEND_DIST=
YTC_LOG_LEVEL=INFO
