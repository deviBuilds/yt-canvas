# Copy to .env (repository root) and adjust. Real environment variables override this file.
# All sizes are in MB, durations in seconds unless noted.

# --- Storage -----------------------------------------------------------------
# Where prepared media, per-job scratch space and the yt-dlp cache live.
# Default: <system temp dir>/yt-canvas
# YTC_DATA_DIR=/var/tmp/yt-canvas
# Total size of prepared media kept on disk; least-recently-used files are evicted.
YTC_CACHE_MAX_MB=4096
# Prepared media not accessed for this many hours is deleted.
YTC_CACHE_TTL_HOURS=6
# Refuse to start a preparation that would leave less free disk than this.
YTC_MIN_FREE_DISK_MB=1024
YTC_CLEANUP_INTERVAL_SECONDS=300

# --- Media preparation ---------------------------------------------------------
# Highest video height to prepare (H.264 at or below this is preferred).
YTC_MAX_HEIGHT=720
YTC_MAX_CONCURRENT_JOBS=2
YTC_MAX_QUEUED_JOBS=16
YTC_MAX_DOWNLOAD_MB=1024
YTC_MAX_DURATION_SECONDS=7200
YTC_RESOLVE_TIMEOUT=60
YTC_DOWNLOAD_TIMEOUT=1800
YTC_PROCESS_TIMEOUT=1800

# Only used when remuxing is impossible (e.g. VP9/AV1/Opus sources).
YTC_TRANSCODE_PRESET=veryfast
YTC_TRANSCODE_CRF=23
YTC_TRANSCODE_AUDIO_BITRATE=128k
# 0 lets FFmpeg decide.
YTC_FFMPEG_THREADS=2

# --- Discovery -------------------------------------------------------------------
YTC_PAGE_SIZE=20
YTC_MAX_SEARCH_RESULTS=100
YTC_MAX_LIST_RESULTS=500
YTC_METADATA_CACHE_TTL=600
YTC_DISCOVERY_TIMEOUT=45

# --- External tools ------------------------------------------------------------------
# yt-dlp needs a JavaScript runtime for YouTube. Deno (>= 2.3) is used automatically if it
# is on PATH. To use Node (>= 22) instead: YTC_YTDLP_JS_RUNTIMES=node
# (comma-separated, optional path: deno:/opt/deno/bin/deno)
# YTC_YTDLP_JS_RUNTIMES=
# Defaults to "<backend python> -m yt_dlp".
# YTC_YTDLP_COMMAND=
# YTC_FFMPEG_PATH=ffmpeg
# YTC_FFPROBE_PATH=ffprobe

# --- App ---------------------------------------------------------------------------------
# Locally generated DEMO/TEST media (no network needed).
YTC_ENABLE_DEMO=true
# Cap demo generation at N× real time, like a download (0 = as fast as possible; FFmpeg 5.0+).
# The e2e suite uses 4 so preparation states stay observable on fast machines.
# YTC_DEMO_READRATE=0
# Production build served by the backend on the same origin. Default: frontend/dist
# YTC_FRONTEND_DIST=
YTC_LOG_LEVEL=INFO
